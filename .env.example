# ─── قاعدة البيانات (PostgreSQL) ───────────────────────────────────────────
# يُفضّل Neon: https://neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ─── Better Auth ────────────────────────────────────────────────────────────
# أنشئ سراً عشوائياً: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# ─── Ably (الرسائل الفورية) ─────────────────────────────────────────────────
# https://ably.com — استخدم مفتاح API كاملاً
NEXT_PUBLIC_ABLY_KEY=your-ably-api-key

# ─── Web Push (VAPID) ───────────────────────────────────────────────────────
# أنشئ المفاتيح: npx web-push generate-vapid-keys
VAPID_EMAIL=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
